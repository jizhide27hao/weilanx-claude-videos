[
 {
  "i": 1,
  "start": 0.45,
  "end": 3.16,
  "text": "现在，微信月活 14.18 亿"
 },
 {
  "i": 2,
  "start": 3.38,
  "end": 5.37,
  "text": "做它的公司，叫腾讯"
 },
 {
  "i": 3,
  "start": 5.59,
  "end": 8.09,
  "text": "创业第二年，它想把公司卖掉"
 },
 {
  "i": 4,
  "start": 8.31,
  "end": 10.73,
  "text": "开价 100 万，没人给到这个数"
 },
 {
  "i": 5,
  "start": 10.95,
  "end": 12.97,
  "text": "最高的，只出 60 万"
 },
 {
  "i": 6,
  "start": 13.19,
  "end": 16.5,
  "text": "28 年，从没人要，到 14 亿人离不开"
 },
 {
  "i": 7,
  "start": 16.72,
  "end": 18.83,
  "text": "得把这 28 年拉出来看"
 },
 {
  "i": 8,
  "start": 19.05,
  "end": 21.81,
  "text": "1998 年 11 月 11 日，深圳"
 },
 {
  "i": 9,
  "start": 22.03,
  "end": 24.17,
  "text": "五个年轻人，凑了 50 万"
 },
 {
  "i": 10,
  "start": 24.39,
  "end": 26.84,
  "text": "三个月后，O I C Q 上线"
 },
 {
  "i": 11,
  "start": 27.06,
  "end": 29.24,
  "text": "抄的是以色列的 ICQ"
 },
 {
  "i": 12,
  "start": 29.46,
  "end": 31.45,
  "text": "两个月，用户 20 万"
 },
 {
  "i": 13,
  "start": 31.67,
  "end": 33.43,
  "text": "到年底，100 万"
 },
 {
  "i": 14,
  "start": 33.65,
  "end": 35.97,
  "text": "服务器要钱，托管费要钱"
 },
 {
  "i": 15,
  "start": 36.19,
  "end": 37.95,
  "text": "一分钱收入都没有"
 },
 {
  "i": 16,
  "start": 38.17,
  "end": 40.64,
  "text": "1999 年底，账上撑不住了"
 },
 {
  "i": 17,
  "start": 40.86,
  "end": 43.28,
  "text": "开价 100 万，想把公司卖掉"
 },
 {
  "i": 18,
  "start": 43.5,
  "end": 46.17,
  "text": "一连谈了四家，最高只出 60 万"
 },
 {
  "i": 19,
  "start": 46.39,
  "end": 48.14,
  "text": "他没卖，接着干"
 },
 {
  "i": 20,
  "start": 48.36,
  "end": 51.33,
  "text": "2000 年 4 月，IDG 和盈科进来"
 },
 {
  "i": 21,
  "start": 51.55,
  "end": 54.36,
  "text": "220 万美元，拿走 40%"
 },
 {
  "i": 22,
  "start": 54.58,
  "end": 57.05,
  "text": "IDG 问，这东西怎么赚钱"
 },
 {
  "i": 23,
  "start": 57.27,
  "end": 59.29,
  "text": "马化腾说，我也不知道"
 },
 {
  "i": 24,
  "start": 59.51,
  "end": 61.72,
  "text": "2000 年底，移动梦网来了"
 },
 {
  "i": 25,
  "start": 61.94,
  "end": 64.39,
  "text": "短信上 Q Q，话费里分成"
 },
 {
  "i": 26,
  "start": 64.61,
  "end": 67.85,
  "text": "2001 年底，首次盈利 1,022 万"
 },
 {
  "i": 27,
  "start": 68.07,
  "end": 70.44,
  "text": "同一年，一个南非人找上门"
 },
 {
  "i": 28,
  "start": 70.66,
  "end": 73.25,
  "text": "M I H 给的估值，6,000 万美元"
 },
 {
  "i": 29,
  "start": 73.47,
  "end": 75.15,
  "text": "是上一轮的 11 倍"
 },
 {
  "i": 30,
  "start": 75.37,
  "end": 78.9,
  "text": "盈科把 20% 全卖了，1,260 万美元"
 },
 {
  "i": 31,
  "start": 79.12,
  "end": 81.93,
  "text": "这笔股权，今天值七千多亿港元"
 },
 {
  "i": 32,
  "start": 82.15,
  "end": 84.77,
  "text": "2004 年 6 月 16 日，香港"
 },
 {
  "i": 33,
  "start": 84.99,
  "end": 88.08,
  "text": "第一家港股主板上市的中国互联网公司"
 },
 {
  "i": 34,
  "start": 88.3,
  "end": 91.25,
  "text": "发行价 3.7 港元，市值 62 亿"
 },
 {
  "i": 35,
  "start": 91.47,
  "end": 94.09,
  "text": "那天，Q Q 用户 2.91 亿"
 },
 {
  "i": 36,
  "start": 94.31,
  "end": 96.81,
  "text": "2003 年，Q Q 秀上线"
 },
 {
  "i": 37,
  "start": 97.03,
  "end": 99.83,
  "text": "几块钱一件的虚拟衣服，几百万人买"
 },
 {
  "i": 38,
  "start": 100.05,
  "end": 102.57,
  "text": "Q 币、会员，一套一套跟上"
 },
 {
  "i": 39,
  "start": 102.79,
  "end": 105.07,
  "text": "同一年，Q Q 游戏上线"
 },
 {
  "i": 40,
  "start": 105.29,
  "end": 108.13,
  "text": "穿越火线、地下城，一款接一款"
 },
 {
  "i": 41,
  "start": 108.35,
  "end": 111.27,
  "text": "到 2009 年，中国最大的游戏公司"
 },
 {
  "i": 42,
  "start": 111.49,
  "end": 115.29,
  "text": "2010 年 9 月，360 指控 Q Q 偷窥隐私"
 },
 {
  "i": 43,
  "start": 115.51,
  "end": 117.83,
  "text": "11 月 3 日晚，腾讯出招"
 },
 {
  "i": 44,
  "start": 118.05,
  "end": 120.77,
  "text": "装了 360 的电脑，停用 Q Q"
 },
 {
  "i": 45,
  "start": 120.99,
  "end": 123.15,
  "text": "几亿网民，被迫二选一"
 },
 {
  "i": 46,
  "start": 123.37,
  "end": 125.91,
  "text": "那封信说，一个非常艰难的决定"
 },
 {
  "i": 47,
  "start": 126.13,
  "end": 128.36,
  "text": "舆论一边倒，全网都在骂"
 },
 {
  "i": 48,
  "start": 128.58,
  "end": 130.55,
  "text": "官司赢了，人心输了"
 },
 {
  "i": 49,
  "start": 130.77,
  "end": 133.7,
  "text": "打仗那一年，国外冒出一款 Kik"
 },
 {
  "i": 50,
  "start": 133.92,
  "end": 136.13,
  "text": "广州的张小龙，坐不住了"
 },
 {
  "i": 51,
  "start": 136.35,
  "end": 138.96,
  "text": "半夜给马化腾写信，建议立项"
 },
 {
  "i": 52,
  "start": 139.18,
  "end": 142.06,
  "text": "2011 年 1 月 21 日，微信上线"
 },
 {
  "i": 53,
  "start": 142.28,
  "end": 144.8,
  "text": "比它早一个月的，是小米的米聊"
 },
 {
  "i": 54,
  "start": 145.02,
  "end": 147.52,
  "text": "语音、摇一摇，功能一路加"
 },
 {
  "i": 55,
  "start": 147.74,
  "end": 150.11,
  "text": "433 天，用户破亿"
 },
 {
  "i": 56,
  "start": 150.33,
  "end": 152.73,
  "text": "移动互联网的船票，到手了"
 },
 {
  "i": 57,
  "start": 152.95,
  "end": 155.76,
  "text": "2013 年 8 月，微信支付上线"
 },
 {
  "i": 58,
  "start": 155.98,
  "end": 158.09,
  "text": "但绑卡的人，一直不多"
 },
 {
  "i": 59,
  "start": 158.31,
  "end": 160.83,
  "text": "2014 年除夕，红包上线"
 },
 {
  "i": 60,
  "start": 161.05,
  "end": 163.69,
  "text": "一夜之间，482 万人在抢"
 },
 {
  "i": 61,
  "start": 163.91,
  "end": 165.86,
  "text": "想领钱，得先绑卡"
 },
 {
  "i": 62,
  "start": 166.08,
  "end": 168.5,
  "text": "马云说，像被偷袭了珍珠港"
 },
 {
  "i": 63,
  "start": 168.72,
  "end": 171.65,
  "text": "2015 年春晚，摇出 110 亿次"
 },
 {
  "i": 64,
  "start": 171.87,
  "end": 175.61,
  "text": "2016 年 9 月，市值 2 万亿港元，亚洲第一"
 },
 {
  "i": 65,
  "start": 175.83,
  "end": 178.52,
  "text": "2017 年 11 月，超过 Facebook"
 },
 {
  "i": 66,
  "start": 178.74,
  "end": 181.65,
  "text": "5,345 亿美元，全球前五"
 },
 {
  "i": 67,
  "start": 181.87,
  "end": 184.36,
  "text": "一款《王者荣耀》，成了国民游戏"
 },
 {
  "i": 68,
  "start": 184.58,
  "end": 187.8,
  "text": "2018 年 1 月，市值 4.5 万亿港元"
 },
 {
  "i": 69,
  "start": 188.02,
  "end": 190.27,
  "text": "三个月后，游戏版号停发"
 },
 {
  "i": 70,
  "start": 190.49,
  "end": 192.27,
  "text": "游戏占了四成收入"
 },
 {
  "i": 71,
  "start": 192.49,
  "end": 195.44,
  "text": "股价从 475，跌到 250"
 },
 {
  "i": 72,
  "start": 195.66,
  "end": 198.04,
  "text": "市值蒸发一万七千亿港元"
 },
 {
  "i": 73,
  "start": 198.26,
  "end": 200.51,
  "text": "9 月 30 日，一封全员信"
 },
 {
  "i": 74,
  "start": 200.73,
  "end": 203.49,
  "text": "事业群重组，转向产业互联网"
 },
 {
  "i": 75,
  "start": 203.71,
  "end": 206.95,
  "text": "2021 年 1 月 25 日，766 港元"
 },
 {
  "i": 76,
  "start": 207.17,
  "end": 210.32,
  "text": "市值 7.35 万亿，超过六大行总和"
 },
 {
  "i": 77,
  "start": 210.54,
  "end": 212.24,
  "text": "接着，监管来了"
 },
 {
  "i": 78,
  "start": 212.46,
  "end": 215.58,
  "text": "2022 年 10 月，股价 198 港元"
 },
 {
  "i": 79,
  "start": 215.8,
  "end": 218.11,
  "text": "从最高点，跌去七成四"
 },
 {
  "i": 80,
  "start": 218.33,
  "end": 220.63,
  "text": "市值蒸发 5.4 万亿港元"
 },
 {
  "i": 81,
  "start": 220.85,
  "end": 222.82,
  "text": "跌出全球市值前十"
 },
 {
  "i": 82,
  "start": 223.04,
  "end": 225.58,
  "text": "2023 年，视频号挑大梁"
 },
 {
  "i": 83,
  "start": 225.8,
  "end": 228.13,
  "text": "马化腾叫它，全村的希望"
 },
 {
  "i": 84,
  "start": 228.35,
  "end": 230.99,
  "text": "广告、小游戏，利润一路回升"
 },
 {
  "i": 85,
  "start": 231.21,
  "end": 234.28,
  "text": "2024 年，回购 1,120 亿港元"
 },
 {
  "i": 86,
  "start": 234.5,
  "end": 237.48,
  "text": "2025 年，营收 7,518 亿"
 },
 {
  "i": 87,
  "start": 237.7,
  "end": 240.72,
  "text": "净利 2,248 亿，净利率三成"
 },
 {
  "i": 88,
  "start": 240.94,
  "end": 244.06,
  "text": "微信 14.18 亿，Q Q 还有 5 亿"
 },
 {
  "i": 89,
  "start": 244.28,
  "end": 247.04,
  "text": "混元、元宝，A I 全线压上"
 },
 {
  "i": 90,
  "start": 247.26,
  "end": 250.12,
  "text": "今天，它市值 3.5 万亿港元"
 },
 {
  "i": 91,
  "start": 250.34,
  "end": 252.64,
  "text": "年初，这个数字是 6 万亿"
 },
 {
  "i": 92,
  "start": 252.86,
  "end": 256.05,
  "text": "28 年，两次腰斩，一次差点断粮"
 },
 {
  "i": 93,
  "start": 256.27,
  "end": 258.77,
  "text": "从没人要，到 14 亿人离不开"
 },
 {
  "i": 94,
  "start": 258.99,
  "end": 261.82,
  "text": "Q Q 不是它发明的，微信也不是"
 },
 {
  "i": 95,
  "start": 262.04,
  "end": 264.56,
  "text": "把别人的发明，做到让人离不开"
 },
 {
  "i": 96,
  "start": 264.78,
  "end": 267.28,
  "text": "这是它 28 年，攒下的本事"
 },
 {
  "i": 97,
  "start": 267.5,
  "end": 269.87,
  "text": "下一次掉下去，还爬得起来吗"
 }
]