[
 {
  "i": 1,
  "start": 0.55,
  "end": 2.76,
  "text": "先给你一个数：五十八万"
 },
 {
  "i": 2,
  "start": 3.02,
  "end": 6.5,
  "text": "这是全国平均，从怀孕养到 17 岁的钱"
 },
 {
  "i": 3,
  "start": 6.76,
  "end": 8.82,
  "text": "但这个数有两个问题"
 },
 {
  "i": 4,
  "start": 9.08,
  "end": 11.0,
  "text": "第一，它是平均数"
 },
 {
  "i": 5,
  "start": 11.26,
  "end": 13.64,
  "text": "第二，它不告诉你钱花在哪"
 },
 {
  "i": 6,
  "start": 13.9,
  "end": 17.31,
  "text": "从怀孕前一年，到 17 岁，一共 19 年"
 },
 {
  "i": 7,
  "start": 17.57,
  "end": 19.92,
  "text": "我把这 19 年，切成八段"
 },
 {
  "i": 8,
  "start": 20.18,
  "end": 23.18,
  "text": "最贵的一段不是高中，是小学那六年"
 },
 {
  "i": 9,
  "start": 23.44,
  "end": 25.33,
  "text": "六年，18 万 7"
 },
 {
  "i": 10,
  "start": 25.59,
  "end": 28.45,
  "text": "最便宜的是初中三年，8 万 3"
 },
 {
  "i": 11,
  "start": 28.71,
  "end": 30.56,
  "text": "义务教育不收学费"
 },
 {
  "i": 12,
  "start": 30.82,
  "end": 33.65,
  "text": "生孩子那一年，是单笔最重的一下"
 },
 {
  "i": 13,
  "start": 33.91,
  "end": 35.09,
  "text": "3 万 8"
 },
 {
  "i": 14,
  "start": 35.35,
  "end": 37.75,
  "text": "但每一段里，钱到底花在哪"
 },
 {
  "i": 15,
  "start": 38.01,
  "end": 41.05,
  "text": "先看怀孕前一年，每个月 555"
 },
 {
  "i": 16,
  "start": 41.31,
  "end": 43.86,
  "text": "这一年最大的开销，不是医院"
 },
 {
  "i": 17,
  "start": 44.12,
  "end": 45.77,
  "text": "是住，和行"
 },
 {
  "i": 18,
  "start": 46.03,
  "end": 49.06,
  "text": "198 加 120，占了快六成"
 },
 {
  "i": 19,
  "start": 49.32,
  "end": 52.39,
  "text": "说白了，就是给还没出生的孩子备货"
 },
 {
  "i": 20,
  "start": 52.65,
  "end": 56.35,
  "text": "婴儿床、推车、待产包、跑医院的打车钱"
 },
 {
  "i": 21,
  "start": 56.61,
  "end": 59.29,
  "text": "真正的孕检，一个月只有 50 块"
 },
 {
  "i": 22,
  "start": 59.55,
  "end": 62.63,
  "text": "0 岁这一年，每个月 3,177"
 },
 {
  "i": 23,
  "start": 62.89,
  "end": 64.81,
  "text": "全周期最贵的一个月"
 },
 {
  "i": 24,
  "start": 65.07,
  "end": 67.61,
  "text": "最大的一笔不是奶粉，是医院"
 },
 {
  "i": 25,
  "start": 67.87,
  "end": 69.38,
  "text": "929 块"
 },
 {
  "i": 26,
  "start": 69.64,
  "end": 73.48,
  "text": "分娩、住院、疫苗、体检，全堆在这一年"
 },
 {
  "i": 27,
  "start": 73.74,
  "end": 75.9,
  "text": "第二是住，774"
 },
 {
  "i": 28,
  "start": 76.16,
  "end": 78.56,
  "text": "第三才是吃，742"
 },
 {
  "i": 29,
  "start": 78.82,
  "end": 81.05,
  "text": "1 岁，医院的钱降下来了"
 },
 {
  "i": 30,
  "start": 81.31,
  "end": 84.05,
  "text": "从 929 掉到 593"
 },
 {
  "i": 31,
  "start": 84.31,
  "end": 87.81,
  "text": "吃的钱顶上去，786，全周期最高"
 },
 {
  "i": 32,
  "start": 88.07,
  "end": 90.71,
  "text": "2 岁，医院继续掉到 360"
 },
 {
  "i": 33,
  "start": 90.97,
  "end": 93.52,
  "text": "吃还是排第一，773"
 },
 {
  "i": 34,
  "start": 93.78,
  "end": 95.96,
  "text": "这两年，奶粉钱最凶"
 },
 {
  "i": 35,
  "start": 96.22,
  "end": 99.61,
  "text": "3 岁上幼儿园，账本上多出一个新项目"
 },
 {
  "i": 36,
  "start": 99.87,
  "end": 100.85,
  "text": "教育"
 },
 {
  "i": 37,
  "start": 101.11,
  "end": 104.23,
  "text": "从 2 岁的 163，一下跳到 580"
 },
 {
  "i": 38,
  "start": 104.49,
  "end": 107.39,
  "text": "从这一年开始，教育再也没掉下去过"
 },
 {
  "i": 39,
  "start": 107.65,
  "end": 110.41,
  "text": "小学六年，教育费 715"
 },
 {
  "i": 40,
  "start": 110.67,
  "end": 113.41,
  "text": "第一次超过吃饭，成了第一大开销"
 },
 {
  "i": 41,
  "start": 113.67,
  "end": 115.23,
  "text": "初中反而便宜了"
 },
 {
  "i": 42,
  "start": 115.49,
  "end": 119.02,
  "text": "教育费掉到 467，三年一共 8 万 3"
 },
 {
  "i": 43,
  "start": 119.28,
  "end": 121.41,
  "text": "是学生时代最低的一段"
 },
 {
  "i": 44,
  "start": 121.67,
  "end": 124.79,
  "text": "高中三年，教育费冲到 967"
 },
 {
  "i": 45,
  "start": 125.05,
  "end": 126.52,
  "text": "全周期最高"
 },
 {
  "i": 46,
  "start": 126.78,
  "end": 130.21,
  "text": "把八条叠在一起看，会看到两条反方向的线"
 },
 {
  "i": 47,
  "start": 130.47,
  "end": 134.69,
  "text": "医院的钱从 0 岁的 929，一路掉到 133"
 },
 {
  "i": 48,
  "start": 134.95,
  "end": 138.99,
  "text": "学校的钱从 0 岁的 50，一路涨到 967"
 },
 {
  "i": 49,
  "start": 139.25,
  "end": 142.27,
  "text": "一降一升，中间在 3 岁那年交叉"
 },
 {
  "i": 50,
  "start": 142.53,
  "end": 145.36,
  "text": "3 岁以前，钱花在看病和吃上"
 },
 {
  "i": 51,
  "start": 145.62,
  "end": 148.12,
  "text": "3 岁以后，钱花在上学上"
 },
 {
  "i": 52,
  "start": 148.38,
  "end": 152.39,
  "text": "同样是养一个孩子，地方不一样，价格差 2.8 倍"
 },
 {
  "i": 53,
  "start": 152.65,
  "end": 155.09,
  "text": "上海一个月 4,751"
 },
 {
  "i": 54,
  "start": 155.35,
  "end": 157.35,
  "text": "西藏 1,711"
 },
 {
  "i": 55,
  "start": 157.61,
  "end": 160.89,
  "text": "全国有 7 个省份超过 3,000，全在东部"
 },
 {
  "i": 56,
  "start": 161.15,
  "end": 162.88,
  "text": "城乡也差得清楚"
 },
 {
  "i": 57,
  "start": 163.14,
  "end": 166.77,
  "text": "城镇 3,127，乡村 1,719"
 },
 {
  "i": 58,
  "start": 167.03,
  "end": 168.99,
  "text": "城镇贵 82%"
 },
 {
  "i": 59,
  "start": 169.25,
  "end": 172.06,
  "text": "同一个孩子，还能用另外两种算法"
 },
 {
  "i": 60,
  "start": 172.32,
  "end": 174.12,
  "text": "第一种，全都算"
 },
 {
  "i": 61,
  "start": 174.38,
  "end": 177.26,
  "text": "全家开销按比例摊到孩子头上"
 },
 {
  "i": 62,
  "start": 177.52,
  "end": 180.98,
  "text": "一个月 2,544，19 年 58 万"
 },
 {
  "i": 63,
  "start": 181.24,
  "end": 183.54,
  "text": "第二种，只算非花不可的"
 },
 {
  "i": 64,
  "start": 183.8,
  "end": 187.45,
  "text": "改善住房、兴趣班、贵一点的衣物，都剔掉"
 },
 {
  "i": 65,
  "start": 187.71,
  "end": 190.97,
  "text": "一个月 1,733，少 32%"
 },
 {
  "i": 66,
  "start": 191.23,
  "end": 193.37,
  "text": "第三种，只算多出来的"
 },
 {
  "i": 67,
  "start": 193.63,
  "end": 197.18,
  "text": "家里吃穿用度照旧，只算因为这个人才多花的"
 },
 {
  "i": 68,
  "start": 197.44,
  "end": 200.59,
  "text": "一个月 1,110，少 56%"
 },
 {
  "i": 69,
  "start": 200.85,
  "end": 204.3,
  "text": "58 万，39.5 万，25.3 万"
 },
 {
  "i": 70,
  "start": 204.56,
  "end": 206.79,
  "text": "同一个孩子，三个价格"
 },
 {
  "i": 71,
  "start": 207.05,
  "end": 209.67,
  "text": "你按哪一种养，账就是哪一个数"
 },
 {
  "i": 72,
  "start": 209.93,
  "end": 213.0,
  "text": "25.3 万，是所有孩子平均下来的"
 },
 {
  "i": 73,
  "start": 213.26,
  "end": 216.79,
  "text": "如果这是第一个孩子，其实是 28.9 万"
 },
 {
  "i": 74,
  "start": 217.05,
  "end": 220.22,
  "text": "第二个 20.7 万，第三个 17.6 万"
 },
 {
  "i": 75,
  "start": 220.48,
  "end": 223.84,
  "text": "第四个只剩 10.7 万，第一个的三分之一"
 },
 {
  "i": 76,
  "start": 224.1,
  "end": 227.6,
  "text": "衣服、玩具、婴儿床，后面都能接着用"
 },
 {
  "i": 77,
  "start": 227.86,
  "end": 230.31,
  "text": "上面所有的数，都只算了钱"
 },
 {
  "i": 78,
  "start": 230.57,
  "end": 233.19,
  "text": "还有三样，一天也没进过账单"
 },
 {
  "i": 79,
  "start": 233.45,
  "end": 234.96,
  "text": "第一样是时间"
 },
 {
  "i": 80,
  "start": 235.22,
  "end": 239.01,
  "text": "孩子 0 到 6 岁，妈妈每周少 12.6 小时闲暇"
 },
 {
  "i": 81,
  "start": 239.27,
  "end": 240.95,
  "text": "爸爸少 8.8 个"
 },
 {
  "i": 82,
  "start": 241.21,
  "end": 242.67,
  "text": "第二样是机会"
 },
 {
  "i": 83,
  "start": 242.93,
  "end": 247.04,
  "text": "生孩子那一年，女性劳动参与率下降 40%"
 },
 {
  "i": 84,
  "start": 247.3,
  "end": 249.63,
  "text": "工资当年下降 18%"
 },
 {
  "i": 85,
  "start": 249.89,
  "end": 252.5,
  "text": "一生的工作时间少 6 到 7 年"
 },
 {
  "i": 86,
  "start": 252.76,
  "end": 254.95,
  "text": "折合收入大约 30 万"
 },
 {
  "i": 87,
  "start": 255.21,
  "end": 257.99,
  "text": "这笔钱不是花掉的，是没赚到的"
 },
 {
  "i": 88,
  "start": 258.25,
  "end": 259.83,
  "text": "第三样是健康"
 },
 {
  "i": 89,
  "start": 260.09,
  "end": 263.55,
  "text": "盆底损伤、睡眠碎片化、围产期焦虑"
 },
 {
  "i": 90,
  "start": 263.81,
  "end": 266.16,
  "text": "这些没有价格，但有代价"
 },
 {
  "i": 91,
  "start": 266.42,
  "end": 268.92,
  "text": "58 万，是被平均过的数"
 },
 {
  "i": 92,
  "start": 269.18,
  "end": 272.03,
  "text": "一半家庭，在 14.77 万以下"
 },
 {
  "i": 93,
  "start": 272.29,
  "end": 275.13,
  "text": "但纸上的每一个数，都有人真的付了"
 },
 {
  "i": 94,
  "start": 275.39,
  "end": 278.19,
  "text": "你家养娃，每个月大概花多少钱"
 }
]