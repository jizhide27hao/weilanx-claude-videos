[
 {
  "i": 1,
  "start": 0.45,
  "end": 3.43,
  "text": "现在，百度市值约 270 亿美元"
 },
 {
  "i": 2,
  "start": 3.65,
  "end": 6.17,
  "text": "五年前，这个数是 1200 亿"
 },
 {
  "i": 3,
  "start": 6.39,
  "end": 8.4,
  "text": "五年，跌掉了近八成"
 },
 {
  "i": 4,
  "start": 8.62,
  "end": 11.67,
  "text": "可它的无人车，跑进了全球 26 座城"
 },
 {
  "i": 5,
  "start": 11.89,
  "end": 14.22,
  "text": "AI 收入占比，四成三"
 },
 {
  "i": 6,
  "start": 14.44,
  "end": 16.91,
  "text": "故事最强的年份，股价最弱"
 },
 {
  "i": 7,
  "start": 17.13,
  "end": 19.0,
  "text": "得把时间线拉出来看"
 },
 {
  "i": 8,
  "start": 19.22,
  "end": 21.57,
  "text": "2000 年 1 月，中关村"
 },
 {
  "i": 9,
  "start": 21.79,
  "end": 24.27,
  "text": "北大资源宾馆，租了两间房"
 },
 {
  "i": 10,
  "start": 24.49,
  "end": 27.34,
  "text": "李彦宏，三十一岁，硅谷工程师"
 },
 {
  "i": 11,
  "start": 27.56,
  "end": 30.47,
  "text": "兜里揣着一项美国专利，超链分析"
 },
 {
  "i": 12,
  "start": 30.69,
  "end": 33.59,
  "text": "和徐勇，融来第一笔 120 万美元"
 },
 {
  "i": 13,
  "start": 33.81,
  "end": 36.43,
  "text": "一行八人，给门户网站做搜索"
 },
 {
  "i": 14,
  "start": 36.65,
  "end": 39.17,
  "text": "九个月后，风投追投一千万"
 },
 {
  "i": 15,
  "start": 39.39,
  "end": 42.27,
  "text": "2001 年，他要做自己的搜索网站"
 },
 {
  "i": 16,
  "start": 42.49,
  "end": 44.41,
  "text": "董事会，一致反对"
 },
 {
  "i": 17,
  "start": 44.63,
  "end": 47.15,
  "text": "断了门户订单，收入立刻归零"
 },
 {
  "i": 18,
  "start": 47.37,
  "end": 49.79,
  "text": "李彦宏拍了桌子，股东让了步"
 },
 {
  "i": 19,
  "start": 50.01,
  "end": 52.67,
  "text": "是你的态度打动了我们，不是论据"
 },
 {
  "i": 20,
  "start": 52.89,
  "end": 55.63,
  "text": "竞价排名上线，商业模式立住"
 },
 {
  "i": 21,
  "start": 55.85,
  "end": 58.37,
  "text": "闪电计划，九个月对标谷歌"
 },
 {
  "i": 22,
  "start": 58.59,
  "end": 61.25,
  "text": "2003 年，流量做到中文第一"
 },
 {
  "i": 23,
  "start": 61.47,
  "end": 64.14,
  "text": "2005 年 8 月 5 号，纳斯达克"
 },
 {
  "i": 24,
  "start": 64.36,
  "end": 66.35,
  "text": "发行价，二十七美元"
 },
 {
  "i": 25,
  "start": 66.57,
  "end": 69.35,
  "text": "开盘 66，盘中冲到 151"
 },
 {
  "i": 26,
  "start": 69.57,
  "end": 73.17,
  "text": "收盘 122.54，涨了 354%"
 },
 {
  "i": 27,
  "start": 73.39,
  "end": 75.82,
  "text": "华尔街五年来的首日涨幅纪录"
 },
 {
  "i": 28,
  "start": 76.04,
  "end": 78.87,
  "text": "市值一天冲到 39.58 亿美元"
 },
 {
  "i": 29,
  "start": 79.09,
  "end": 82.11,
  "text": "可它上一年利润，只有一千三百万美元"
 },
 {
  "i": 30,
  "start": 82.33,
  "end": 84.66,
  "text": "市盈率，两千四百五十倍"
 },
 {
  "i": 31,
  "start": 84.88,
  "end": 87.88,
  "text": "2005 年底，市值腰斩到 20 亿"
 },
 {
  "i": 32,
  "start": 88.1,
  "end": 91.08,
  "text": "2008 年金融危机，跌到 45 亿"
 },
 {
  "i": 33,
  "start": 91.3,
  "end": 93.75,
  "text": "转机出现在 2010 年 3 月"
 },
 {
  "i": 34,
  "start": 93.97,
  "end": 95.84,
  "text": "谷歌退出中国大陆"
 },
 {
  "i": 35,
  "start": 96.06,
  "end": 98.63,
  "text": "百度接下全部份额，一家独大"
 },
 {
  "i": 36,
  "start": 98.85,
  "end": 101.63,
  "text": "当年底，市值 336 亿美元"
 },
 {
  "i": 37,
  "start": 101.85,
  "end": 104.78,
  "text": "2011 年 3 月，462 亿美元"
 },
 {
  "i": 38,
  "start": 105.0,
  "end": 107.21,
  "text": "压过腾讯的 446 亿"
 },
 {
  "i": 39,
  "start": 107.43,
  "end": 109.99,
  "text": "中国互联网市值，第一次换庄"
 },
 {
  "i": 40,
  "start": 110.21,
  "end": 112.71,
  "text": "它成了 PC 时代的流量之王"
 },
 {
  "i": 41,
  "start": 112.93,
  "end": 115.55,
  "text": "但口袋里的屏幕，正在换掉电脑"
 },
 {
  "i": 42,
  "start": 115.77,
  "end": 118.62,
  "text": "2012 年，李彦宏却说了一个比喻"
 },
 {
  "i": 43,
  "start": 118.84,
  "end": 121.46,
  "text": "移动互联像酒驾，刺激但危险"
 },
 {
  "i": 44,
  "start": 121.68,
  "end": 124.77,
  "text": "那一年，微信刚上线，头条刚创立"
 },
 {
  "i": 45,
  "start": 124.99,
  "end": 127.25,
  "text": "2013 年，百度才慌了"
 },
 {
  "i": 46,
  "start": 127.47,
  "end": 129.99,
  "text": "19 亿美元，买下 91 无线"
 },
 {
  "i": 47,
  "start": 130.21,
  "end": 133.04,
  "text": "两年后，应用商店被手机厂干掉"
 },
 {
  "i": 48,
  "start": 133.26,
  "end": 135.49,
  "text": "这笔钱，成了最贵的船票"
 },
 {
  "i": 49,
  "start": 135.71,
  "end": 137.8,
  "text": "转身又砸 200 亿进糯米"
 },
 {
  "i": 50,
  "start": 138.02,
  "end": 141.05,
  "text": "烧完钱，外卖和糯米都成了历史"
 },
 {
  "i": 51,
  "start": 141.27,
  "end": 143.93,
  "text": "2016 年 1 月，血友病吧被卖"
 },
 {
  "i": 52,
  "start": 144.15,
  "end": 146.86,
  "text": "贴吧商业化，第一次被骂上热搜"
 },
 {
  "i": 53,
  "start": 147.08,
  "end": 149.55,
  "text": "4 月，大学生魏则西去世"
 },
 {
  "i": 54,
  "start": 149.77,
  "end": 152.41,
  "text": "他在百度搜到的医院，是莆田系"
 },
 {
  "i": 55,
  "start": 152.63,
  "end": 155.2,
  "text": "调查组进驻，竞价排名整改"
 },
 {
  "i": 56,
  "start": 155.42,
  "end": 158.09,
  "text": "商业推广，每页不得超过三成"
 },
 {
  "i": 57,
  "start": 158.31,
  "end": 160.75,
  "text": "那一年净利润，跌掉六成五"
 },
 {
  "i": 58,
  "start": 160.97,
  "end": 163.4,
  "text": "2017 年 1 月，陆奇空降"
 },
 {
  "i": 59,
  "start": 163.62,
  "end": 166.74,
  "text": "裁医疗部，砍游戏，全力押注 AI"
 },
 {
  "i": 60,
  "start": 166.96,
  "end": 169.41,
  "text": "无人车平台开源，叫阿波罗"
 },
 {
  "i": 61,
  "start": 169.63,
  "end": 171.71,
  "text": "市值回升到 800 亿上方"
 },
 {
  "i": 62,
  "start": 171.93,
  "end": 174.31,
  "text": "可惜十六个月后，陆奇离开"
 },
 {
  "i": 63,
  "start": 174.53,
  "end": 176.64,
  "text": "市值跌回 553 亿"
 },
 {
  "i": 64,
  "start": 176.86,
  "end": 179.86,
  "text": "2019 年，上市后首次季度亏损"
 },
 {
  "i": 65,
  "start": 180.08,
  "end": 181.83,
  "text": "市值跌破四百亿"
 },
 {
  "i": 66,
  "start": 182.05,
  "end": 184.86,
  "text": "有人干脆说，BAT 只剩 AT"
 },
 {
  "i": 67,
  "start": 185.08,
  "end": 188.23,
  "text": "2020 年，机构重仓，无人车翻红"
 },
 {
  "i": 68,
  "start": 188.45,
  "end": 191.06,
  "text": "2021 年 2 月，市值破千亿"
 },
 {
  "i": 69,
  "start": 191.28,
  "end": 193.85,
  "text": "十天后，冲上 1200 亿美元"
 },
 {
  "i": 70,
  "start": 194.07,
  "end": 196.23,
  "text": "3 月，回港二次上市"
 },
 {
  "i": 71,
  "start": 196.45,
  "end": 198.59,
  "text": "那是它离巅峰最近的时候"
 },
 {
  "i": 72,
  "start": 198.81,
  "end": 200.77,
  "text": "然后，是四年的阴跌"
 },
 {
  "i": 73,
  "start": 200.99,
  "end": 203.87,
  "text": "搜索广告，被短视频一点点切走"
 },
 {
  "i": 74,
  "start": 204.09,
  "end": 206.57,
  "text": "2024 年底，只剩 300 亿"
 },
 {
  "i": 75,
  "start": 206.79,
  "end": 208.59,
  "text": "不到腾讯的十分之一"
 },
 {
  "i": 76,
  "start": 208.81,
  "end": 210.89,
  "text": "转机，在另一条赛道上"
 },
 {
  "i": 77,
  "start": 211.11,
  "end": 213.87,
  "text": "2023 年 3 月，文心一言发布"
 },
 {
  "i": 78,
  "start": 214.09,
  "end": 216.85,
  "text": "中国第一批对标 GPT 的大模型"
 },
 {
  "i": 79,
  "start": 217.07,
  "end": 219.74,
  "text": "2025 年，萝卜快跑开始爆发"
 },
 {
  "i": 80,
  "start": 219.96,
  "end": 222.91,
  "text": "四季度，无人车订单三百四十万单"
 },
 {
  "i": 81,
  "start": 223.13,
  "end": 225.94,
  "text": "累计两千万单，覆盖二十六座城"
 },
 {
  "i": 82,
  "start": 226.16,
  "end": 228.58,
  "text": "中东双城开跑，伦敦签约"
 },
 {
  "i": 83,
  "start": 228.8,
  "end": 231.06,
  "text": "文心助手，月活破两亿"
 },
 {
  "i": 84,
  "start": 231.28,
  "end": 234.42,
  "text": "四季度 AI 收入占比，43%"
 },
 {
  "i": 85,
  "start": 234.64,
  "end": 236.78,
  "text": "芯片业务递表港交所"
 },
 {
  "i": 86,
  "start": 237.0,
  "end": 239.45,
  "text": "五十亿美元回购，首次派息"
 },
 {
  "i": 87,
  "start": 239.67,
  "end": 242.86,
  "text": "2026 年，市值却只剩 270 亿"
 },
 {
  "i": 88,
  "start": 243.08,
  "end": 245.12,
  "text": "一年，又跌掉三成五"
 },
 {
  "i": 89,
  "start": 245.34,
  "end": 247.95,
  "text": "市场不信故事，只信现金流"
 },
 {
  "i": 90,
  "start": 248.17,
  "end": 250.53,
  "text": "搜索的时代，它错过了手机"
 },
 {
  "i": 91,
  "start": 250.75,
  "end": 253.07,
  "text": "AI 的时代，它还在牌桌上"
 },
 {
  "i": 92,
  "start": 253.29,
  "end": 256.01,
  "text": "26 年，从一百二十万美元起家"
 },
 {
  "i": 93,
  "start": 256.23,
  "end": 258.27,
  "text": "下一段路，才刚开始"
 }
]