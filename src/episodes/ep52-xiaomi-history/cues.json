[
 {
  "i": 1,
  "start": 0.45,
  "end": 3.21,
  "text": "现在，小米市值近 7000 亿港元"
 },
 {
  "i": 2,
  "start": 3.43,
  "end": 6.43,
  "text": "去年夏天，这个数字是 1.55 万亿"
 },
 {
  "i": 3,
  "start": 6.65,
  "end": 7.97,
  "text": "一半多没了"
 },
 {
  "i": 4,
  "start": 8.19,
  "end": 11.6,
  "text": "就在上个月，汽车月交付首次破 4 万台"
 },
 {
  "i": 5,
  "start": 11.82,
  "end": 15.01,
  "text": "砍掉一半多和月卖 4 万台，是同一家"
 },
 {
  "i": 6,
  "start": 15.23,
  "end": 18.35,
  "text": "16 年里，小米一直在两种评价之间"
 },
 {
  "i": 7,
  "start": 18.57,
  "end": 20.97,
  "text": "得把它自己的时间线拉出来看"
 },
 {
  "i": 8,
  "start": 21.19,
  "end": 23.95,
  "text": "2010 年春天，北京银谷大厦"
 },
 {
  "i": 9,
  "start": 24.17,
  "end": 26.35,
  "text": "十四个人，一锅小米粥"
 },
 {
  "i": 10,
  "start": 26.57,
  "end": 29.6,
  "text": "雷军 40 岁，从金山退下来两年多"
 },
 {
  "i": 11,
  "start": 29.82,
  "end": 32.19,
  "text": "他说要办一家世界级的公司"
 },
 {
  "i": 12,
  "start": 32.41,
  "end": 35.1,
  "text": "名字取自一句老话：小米加步枪"
 },
 {
  "i": 13,
  "start": 35.32,
  "end": 38.3,
  "text": "那年苹果已经定义了什么叫好手机"
 },
 {
  "i": 14,
  "start": 38.52,
  "end": 41.23,
  "text": "iPhone 四千多，国产机还在山寨"
 },
 {
  "i": 15,
  "start": 41.45,
  "end": 44.02,
  "text": "小米先做了一件不花什么钱的事"
 },
 {
  "i": 16,
  "start": 44.24,
  "end": 46.66,
  "text": "M I U I，一个改过的安卓"
 },
 {
  "i": 17,
  "start": 46.88,
  "end": 49.16,
  "text": "第一批用户，只有 100 个人"
 },
 {
  "i": 18,
  "start": 49.38,
  "end": 52.24,
  "text": "100 个用户的名字，写进了开机画面"
 },
 {
  "i": 19,
  "start": 52.46,
  "end": 54.57,
  "text": "先有用户，后有产品"
 },
 {
  "i": 20,
  "start": 54.79,
  "end": 57.57,
  "text": "这个顺序，是后来所有争议的起点"
 },
 {
  "i": 21,
  "start": 57.79,
  "end": 60.63,
  "text": "2011 年 8 月，北京 798"
 },
 {
  "i": 22,
  "start": 60.85,
  "end": 62.86,
  "text": "雷军穿着黑 T 恤上台"
 },
 {
  "i": 23,
  "start": 63.08,
  "end": 65.65,
  "text": "小米 1 代，1999 元"
 },
 {
  "i": 24,
  "start": 65.87,
  "end": 68.58,
  "text": "同配置的国际品牌要 4000 以上"
 },
 {
  "i": 25,
  "start": 68.8,
  "end": 70.43,
  "text": "台下当场就炸了"
 },
 {
  "i": 26,
  "start": 70.65,
  "end": 73.58,
  "text": "开放预订，两天就订出 30 万台"
 },
 {
  "i": 27,
  "start": 73.8,
  "end": 76.42,
  "text": "1999 成了小米的图腾"
 },
 {
  "i": 28,
  "start": 76.64,
  "end": 79.4,
  "text": "2013 年，红米 799 元"
 },
 {
  "i": 29,
  "start": 79.62,
  "end": 82.4,
  "text": "千元以下，第一次能买到这个配置"
 },
 {
  "i": 30,
  "start": 82.62,
  "end": 85.57,
  "text": "电视、电源、手环，一个接一个"
 },
 {
  "i": 31,
  "start": 85.79,
  "end": 88.22,
  "text": "小米投了一批公司做生态链"
 },
 {
  "i": 32,
  "start": 88.44,
  "end": 90.89,
  "text": "手机少赚钱，用别的赚钱"
 },
 {
  "i": 33,
  "start": 91.11,
  "end": 93.55,
  "text": "2014 年，中国市场第一"
 },
 {
  "i": 34,
  "start": 93.77,
  "end": 97.13,
  "text": "6112 万台，估值 450 亿美元"
 },
 {
  "i": 35,
  "start": 97.35,
  "end": 99.73,
  "text": "全世界最贵的创业公司之一"
 },
 {
  "i": 36,
  "start": 99.95,
  "end": 103.24,
  "text": "质疑也来了：抢购、缺货、饥饿营销"
 },
 {
  "i": 37,
  "start": 103.46,
  "end": 105.67,
  "text": "小米说，真的是产能不够"
 },
 {
  "i": 38,
  "start": 105.89,
  "end": 108.45,
  "text": "2015 年，第一次没完成目标"
 },
 {
  "i": 39,
  "start": 108.67,
  "end": 111.46,
  "text": "2016 年，中国市场掉到第五"
 },
 {
  "i": 40,
  "start": 111.68,
  "end": 114.46,
  "text": "线上见顶，线下全是别人的地盘"
 },
 {
  "i": 41,
  "start": 114.68,
  "end": 116.55,
  "text": "供应链也出了大问题"
 },
 {
  "i": 42,
  "start": 116.77,
  "end": 118.77,
  "text": "雷军自己接管手机部"
 },
 {
  "i": 43,
  "start": 118.99,
  "end": 121.63,
  "text": "那一年，雷军说，他有点迷茫"
 },
 {
  "i": 44,
  "start": 121.85,
  "end": 124.65,
  "text": "2016 年 10 月，小米 M I X"
 },
 {
  "i": 45,
  "start": 124.87,
  "end": 127.54,
  "text": "屏占比 91%，全面屏"
 },
 {
  "i": 46,
  "start": 127.76,
  "end": 130.61,
  "text": "一款概念机，把便宜两个字撕开一点"
 },
 {
  "i": 47,
  "start": 130.83,
  "end": 133.64,
  "text": "同一年，小米之家开始一家家开"
 },
 {
  "i": 48,
  "start": 133.86,
  "end": 136.07,
  "text": "2017 年，小米反弹"
 },
 {
  "i": 49,
  "start": 136.29,
  "end": 138.26,
  "text": "印度市场份额第一"
 },
 {
  "i": 50,
  "start": 138.48,
  "end": 140.9,
  "text": "全年出货 9240 万台"
 },
 {
  "i": 51,
  "start": 141.12,
  "end": 143.79,
  "text": "从悬崖边回到牌桌，只用一年"
 },
 {
  "i": 52,
  "start": 144.01,
  "end": 146.33,
  "text": "2018 年 7 月，港交所"
 },
 {
  "i": 53,
  "start": 146.55,
  "end": 148.28,
  "text": "发行价 17 港元"
 },
 {
  "i": 54,
  "start": 148.5,
  "end": 151.12,
  "text": "雷军说，要让首日买入的赚一倍"
 },
 {
  "i": 55,
  "start": 151.34,
  "end": 152.87,
  "text": "开盘，破发"
 },
 {
  "i": 56,
  "start": 153.09,
  "end": 155.35,
  "text": "他站在外面说：大势不好"
 },
 {
  "i": 57,
  "start": 155.57,
  "end": 157.25,
  "text": "最低跌到 8 港元"
 },
 {
  "i": 58,
  "start": 157.47,
  "end": 160.04,
  "text": "2019 年，进了世界 500 强"
 },
 {
  "i": 59,
  "start": 160.26,
  "end": 162.51,
  "text": "从创立到上榜，用了 9 年"
 },
 {
  "i": 60,
  "start": 162.73,
  "end": 165.76,
  "text": "2020 年，小米 10，第一次做高端"
 },
 {
  "i": 61,
  "start": 165.98,
  "end": 168.52,
  "text": "2021 年二季度，全球第二"
 },
 {
  "i": 62,
  "start": 168.74,
  "end": 171.6,
  "text": "2021 年 3 月，雷军宣布造车"
 },
 {
  "i": 63,
  "start": 171.82,
  "end": 174.46,
  "text": "首期 100 亿，十年 100 亿美元"
 },
 {
  "i": 64,
  "start": 174.68,
  "end": 177.25,
  "text": "他说，这是最后一次重大创业"
 },
 {
  "i": 65,
  "start": 177.47,
  "end": 180.25,
  "text": "2024 年 3 月，S U 七上市"
 },
 {
  "i": 66,
  "start": 180.47,
  "end": 182.75,
  "text": "27 分钟，大定 5 万台"
 },
 {
  "i": 67,
  "start": 182.97,
  "end": 185.2,
  "text": "全年交付 13.7 万台"
 },
 {
  "i": 68,
  "start": 185.42,
  "end": 188.57,
  "text": "2025 年 5 月，玄戒 O 一，3 纳米"
 },
 {
  "i": 69,
  "start": 188.79,
  "end": 190.8,
  "text": "6 月，Y U 七上市"
 },
 {
  "i": 70,
  "start": 191.02,
  "end": 193.25,
  "text": "3 分钟，大定 20 万台"
 },
 {
  "i": 71,
  "start": 193.47,
  "end": 196.57,
  "text": "次日股价 61.45 港元，历史最高"
 },
 {
  "i": 72,
  "start": 196.79,
  "end": 198.64,
  "text": "市值 1.55 万亿"
 },
 {
  "i": 73,
  "start": 198.86,
  "end": 201.14,
  "text": "从一碗粥到这里，15 年"
 },
 {
  "i": 74,
  "start": 201.36,
  "end": 203.59,
  "text": "然后，股价开始往下走"
 },
 {
  "i": 75,
  "start": 203.81,
  "end": 206.95,
  "text": "2026 年 6 月，最低 21 港元出头"
 },
 {
  "i": 76,
  "start": 207.17,
  "end": 209.55,
  "text": "老订单交完，新订单没来"
 },
 {
  "i": 77,
  "start": 209.77,
  "end": 212.24,
  "text": "汽车单季经营亏损 26 亿"
 },
 {
  "i": 78,
  "start": 212.46,
  "end": 215.82,
  "text": "9 月，澎程上市，4 分钟锁单 1 万台"
 },
 {
  "i": 79,
  "start": 216.04,
  "end": 218.56,
  "text": "当月交付 4 万台，历史最高"
 },
 {
  "i": 80,
  "start": 218.78,
  "end": 221.04,
  "text": "累计交付超过 80 万辆"
 },
 {
  "i": 81,
  "start": 221.26,
  "end": 224.93,
  "text": "16 年，从一碗粥到手机、家电、汽车"
 },
 {
  "i": 82,
  "start": 225.15,
  "end": 228.1,
  "text": "从性价比的故事，变成重资产的故事"
 },
 {
  "i": 83,
  "start": 228.32,
  "end": 231.08,
  "text": "1999 的手机，可以靠一代人记住"
 },
 {
  "i": 84,
  "start": 231.3,
  "end": 234.23,
  "text": "25 万的车，得靠每一辆重新证明"
 },
 {
  "i": 85,
  "start": 234.45,
  "end": 236.49,
  "text": "下一段路，才刚开始"
 }
]