[
 {
  "i": 1,
  "start": 0.45,
  "end": 3.21,
  "text": "现在，阿里市值不到 2 万亿港元"
 },
 {
  "i": 2,
  "start": 3.43,
  "end": 6.12,
  "text": "一年前，这个数是 3.7 万亿"
 },
 {
  "i": 3,
  "start": 6.34,
  "end": 8.5,
  "text": "五年前，是 6.7 万亿"
 },
 {
  "i": 4,
  "start": 8.72,
  "end": 11.91,
  "text": "二十六年，它上过三次市，退过一次市"
 },
 {
  "i": 5,
  "start": 12.13,
  "end": 14.65,
  "text": "从 50 万起家，到 6.7 万亿"
 },
 {
  "i": 6,
  "start": 14.87,
  "end": 17.05,
  "text": "最狠的时候，跌掉了八成"
 },
 {
  "i": 7,
  "start": 17.27,
  "end": 19.41,
  "text": "得把它的时间线拉出来看"
 },
 {
  "i": 8,
  "start": 19.63,
  "end": 22.49,
  "text": "1999 年 2 月，杭州湖畔花园"
 },
 {
  "i": 9,
  "start": 22.71,
  "end": 25.54,
  "text": "一间民宅，十八个人，凑了 50 万"
 },
 {
  "i": 10,
  "start": 25.76,
  "end": 28.3,
  "text": "使命是让天下没有难做的生意"
 },
 {
  "i": 11,
  "start": 28.52,
  "end": 30.97,
  "text": "目标是一家活 102 年的公司"
 },
 {
  "i": 12,
  "start": 31.19,
  "end": 33.93,
  "text": "最难的时候，工资发到一半就没了"
 },
 {
  "i": 13,
  "start": 34.15,
  "end": 36.81,
  "text": "蔡崇信放弃百万年薪，加入了"
 },
 {
  "i": 14,
  "start": 37.03,
  "end": 40.22,
  "text": "1999 年，它拒绝了 38 家投资机构"
 },
 {
  "i": 15,
  "start": 40.44,
  "end": 42.6,
  "text": "最后拿了高盛的 500 万美元"
 },
 {
  "i": 16,
  "start": 42.82,
  "end": 45.49,
  "text": "2000 年 1 月，孙正义见了马云"
 },
 {
  "i": 17,
  "start": 45.71,
  "end": 48.3,
  "text": "六分钟，就决定投 2000 万美元"
 },
 {
  "i": 18,
  "start": 48.52,
  "end": 50.65,
  "text": "这笔钱，后来救了它的命"
 },
 {
  "i": 19,
  "start": 50.87,
  "end": 53.39,
  "text": "那年春天，互联网泡沫破了"
 },
 {
  "i": 20,
  "start": 53.61,
  "end": 57.14,
  "text": "别人在裁员，阿里账上还有 2500 万美元"
 },
 {
  "i": 21,
  "start": 57.36,
  "end": 59.52,
  "text": "2003 年，非典来了"
 },
 {
  "i": 22,
  "start": 59.74,
  "end": 62.6,
  "text": "六个人签了保密协议，回到湖畔花园"
 },
 {
  "i": 23,
  "start": 62.82,
  "end": 64.91,
  "text": "5 月 10 日，淘宝上线"
 },
 {
  "i": 24,
  "start": 65.13,
  "end": 67.12,
  "text": "对手是全球第一的 eBay"
 },
 {
  "i": 25,
  "start": 67.34,
  "end": 70.0,
  "text": "淘宝的打法只有两个字：免费"
 },
 {
  "i": 26,
  "start": 70.22,
  "end": 72.29,
  "text": "开店免费，交易免费"
 },
 {
  "i": 27,
  "start": 72.51,
  "end": 74.91,
  "text": "两年烧钱，eBay 退出中国"
 },
 {
  "i": 28,
  "start": 75.13,
  "end": 77.67,
  "text": "可买卖双方，谁都不敢先付钱"
 },
 {
  "i": 29,
  "start": 77.89,
  "end": 80.55,
  "text": "那就先放我这儿，收到货再给卖家"
 },
 {
  "i": 30,
  "start": 80.77,
  "end": 83.44,
  "text": "2003 年 10 月，支付宝上线"
 },
 {
  "i": 31,
  "start": 83.66,
  "end": 86.3,
  "text": "2005 年，淘宝的钱快烧完了"
 },
 {
  "i": 32,
  "start": 86.52,
  "end": 88.39,
  "text": "雅虎送来 10 亿美元"
 },
 {
  "i": 33,
  "start": 88.61,
  "end": 91.73,
  "text": "外加雅虎中国，换走 40% 的股份"
 },
 {
  "i": 34,
  "start": 91.95,
  "end": 93.41,
  "text": "淘宝活了下来"
 },
 {
  "i": 35,
  "start": 93.63,
  "end": 97.28,
  "text": "2007 年 11 月，B2B 业务在香港上市"
 },
 {
  "i": 36,
  "start": 97.5,
  "end": 100.84,
  "text": "发行价 13.5 港元，募资 116 亿"
 },
 {
  "i": 37,
  "start": 101.06,
  "end": 103.31,
  "text": "首日涨了 193%"
 },
 {
  "i": 38,
  "start": 103.53,
  "end": 107.18,
  "text": "市值近 2000 亿港元，全球第五大互联网公司"
 },
 {
  "i": 39,
  "start": 107.4,
  "end": 109.27,
  "text": "第二年，金融危机"
 },
 {
  "i": 40,
  "start": 109.49,
  "end": 111.73,
  "text": "股价跌到 3.42 港元"
 },
 {
  "i": 41,
  "start": 111.95,
  "end": 114.06,
  "text": "从最高点，跌掉九成"
 },
 {
  "i": 42,
  "start": 114.28,
  "end": 117.81,
  "text": "2012 年，它用 13.5 港元私有化退市"
 },
 {
  "i": 43,
  "start": 118.03,
  "end": 120.5,
  "text": "退市，是为了整个集团上市"
 },
 {
  "i": 44,
  "start": 120.72,
  "end": 123.17,
  "text": "2013 年，它先想回香港"
 },
 {
  "i": 45,
  "start": 123.39,
  "end": 125.79,
  "text": "港交所不接受同股不同权"
 },
 {
  "i": 46,
  "start": 126.01,
  "end": 127.4,
  "text": "只能去美国"
 },
 {
  "i": 47,
  "start": 127.62,
  "end": 130.35,
  "text": "2014 年 9 月 19 日，纽交所"
 },
 {
  "i": 48,
  "start": 130.57,
  "end": 132.37,
  "text": "发行价 68 美元"
 },
 {
  "i": 49,
  "start": 132.59,
  "end": 136.12,
  "text": "募资 250 亿美元，美股史上最大 IPO"
 },
 {
  "i": 50,
  "start": 136.34,
  "end": 139.56,
  "text": "首日收盘，市值超过 2300 亿美元"
 },
 {
  "i": 51,
  "start": 139.78,
  "end": 142.75,
  "text": "全球第二大互联网公司，仅次于谷歌"
 },
 {
  "i": 52,
  "start": 142.97,
  "end": 145.76,
  "text": "2019 年 11 月 26 日，回家"
 },
 {
  "i": 53,
  "start": 145.98,
  "end": 149.07,
  "text": "176 港元，募资 1012 亿"
 },
 {
  "i": 54,
  "start": 149.29,
  "end": 151.86,
  "text": "市值 4 万亿港元，超过腾讯"
 },
 {
  "i": 55,
  "start": 152.08,
  "end": 153.59,
  "text": "港股市值第一"
 },
 {
  "i": 56,
  "start": 153.81,
  "end": 156.55,
  "text": "2020 年，疫情把所有人赶上网"
 },
 {
  "i": 57,
  "start": 156.77,
  "end": 159.6,
  "text": "10 月，股价冲到 309 港元"
 },
 {
  "i": 58,
  "start": 159.82,
  "end": 161.86,
  "text": "市值 6.7 万亿港元"
 },
 {
  "i": 59,
  "start": 162.08,
  "end": 164.17,
  "text": "同一个月，蚂蚁要上市了"
 },
 {
  "i": 60,
  "start": 164.39,
  "end": 167.37,
  "text": "定价 68.8 元，估值 2.1 万亿"
 },
 {
  "i": 61,
  "start": 167.59,
  "end": 170.13,
  "text": "史上最大的 IPO，就要诞生"
 },
 {
  "i": 62,
  "start": 170.35,
  "end": 173.11,
  "text": "10 月 24 日，马云在外滩讲话"
 },
 {
  "i": 63,
  "start": 173.33,
  "end": 175.73,
  "text": "11 月 3 日，上市被叫停"
 },
 {
  "i": 64,
  "start": 175.95,
  "end": 178.37,
  "text": "两万亿的估值，停在了纸上"
 },
 {
  "i": 65,
  "start": 178.59,
  "end": 180.63,
  "text": "12 月，反垄断立案"
 },
 {
  "i": 66,
  "start": 180.85,
  "end": 184.17,
  "text": "2021 年 4 月，罚单 182.28 亿"
 },
 {
  "i": 67,
  "start": 184.39,
  "end": 187.43,
  "text": "这一年，股价跌了 48.88%"
 },
 {
  "i": 68,
  "start": 187.65,
  "end": 189.89,
  "text": "市值蒸发 1.92 万亿"
 },
 {
  "i": 69,
  "start": 190.11,
  "end": 192.77,
  "text": "2022 年 10 月，跌到 60 港元"
 },
 {
  "i": 70,
  "start": 192.99,
  "end": 195.08,
  "text": "从最高点，跌去八成"
 },
 {
  "i": 71,
  "start": 195.3,
  "end": 197.96,
  "text": "芒格抄底，亏了 40% 割肉"
 },
 {
  "i": 72,
  "start": 198.18,
  "end": 200.41,
  "text": "他后来承认，自己看错了"
 },
 {
  "i": 73,
  "start": 200.63,
  "end": 203.23,
  "text": "2023 年 3 月，1+6+N"
 },
 {
  "i": 74,
  "start": 203.45,
  "end": 205.75,
  "text": "八个月后，拆分开始收回"
 },
 {
  "i": 75,
  "start": 205.97,
  "end": 208.59,
  "text": "9 月，蔡崇信和吴泳铭接任"
 },
 {
  "i": 76,
  "start": 208.81,
  "end": 212.14,
  "text": "战略改成六个字：用户为先，AI 驱动"
 },
 {
  "i": 77,
  "start": 212.36,
  "end": 215.63,
  "text": "2025 年 2 月，三年投 3800 亿"
 },
 {
  "i": 78,
  "start": 215.85,
  "end": 219.25,
  "text": "通义千问，成了全球最大的开源模型家族"
 },
 {
  "i": 79,
  "start": 219.47,
  "end": 222.21,
  "text": "2025 年 7 月，淘宝闪购开打"
 },
 {
  "i": 80,
  "start": 222.43,
  "end": 224.9,
  "text": "外卖大战一年，亏掉 900 亿"
 },
 {
  "i": 81,
  "start": 225.12,
  "end": 228.51,
  "text": "2025 年 10 月，股价回到 186 港元"
 },
 {
  "i": 82,
  "start": 228.73,
  "end": 230.53,
  "text": "市值 3.7 万亿"
 },
 {
  "i": 83,
  "start": 230.75,
  "end": 233.75,
  "text": "2026 年 6 月，又跌回 88 港元"
 },
 {
  "i": 84,
  "start": 233.97,
  "end": 236.25,
  "text": "八个月，蒸发 1.8 万亿"
 },
 {
  "i": 85,
  "start": 236.47,
  "end": 238.84,
  "text": "7 月，千问进了苹果的系统"
 },
 {
  "i": 86,
  "start": 239.06,
  "end": 242.66,
  "text": "AI 云收入涨 45%，22 个季度新高"
 },
 {
  "i": 87,
  "start": 242.88,
  "end": 246.15,
  "text": "今天，97.8 港元，1.95 万亿"
 },
 {
  "i": 88,
  "start": 246.37,
  "end": 249.58,
  "text": "二十六年，三次上市，两次差点倒下"
 },
 {
  "i": 89,
  "start": 249.8,
  "end": 252.08,
  "text": "每一次，它都换了一套活法"
 },
 {
  "i": 90,
  "start": 252.3,
  "end": 254.34,
  "text": "下一段路，才刚开始"
 }
]