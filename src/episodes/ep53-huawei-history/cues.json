[
 {
  "i": 1,
  "start": 0.45,
  "end": 3.5,
  "text": "今年上半年，华为赚了 234 亿"
 },
 {
  "i": 2,
  "start": 3.72,
  "end": 7.25,
  "text": "同一半年，它花在研发上 1213 亿"
 },
 {
  "i": 3,
  "start": 7.47,
  "end": 9.91,
  "text": "赚的，不够研发花的五分之一"
 },
 {
  "i": 4,
  "start": 10.13,
  "end": 13.49,
  "text": "近十年，它往研发里投了 1.38 万亿"
 },
 {
  "i": 5,
  "start": 13.71,
  "end": 16.74,
  "text": "1987 年，它的本钱是 2.1 万块"
 },
 {
  "i": 6,
  "start": 16.96,
  "end": 19.62,
  "text": "39 年里，它三次差点没过去"
 },
 {
  "i": 7,
  "start": 19.84,
  "end": 21.79,
  "text": "每次都换了一条命回来"
 },
 {
  "i": 8,
  "start": 22.01,
  "end": 24.41,
  "text": "得把它自己的时间线拉出来看"
 },
 {
  "i": 9,
  "start": 24.63,
  "end": 26.86,
  "text": "1987 年 9 月，深圳"
 },
 {
  "i": 10,
  "start": 27.08,
  "end": 30.08,
  "text": "43 岁的任正非，凑了 2.1 万元"
 },
 {
  "i": 11,
  "start": 30.3,
  "end": 32.58,
  "text": "名字取自一句：中华有为"
 },
 {
  "i": 12,
  "start": 32.8,
  "end": 34.5,
  "text": "这家公司叫华为"
 },
 {
  "i": 13,
  "start": 34.72,
  "end": 37.12,
  "text": "生意是代理香港来的交换机"
 },
 {
  "i": 14,
  "start": 37.34,
  "end": 40.1,
  "text": "从香港买，转手卖给县邮电局"
 },
 {
  "i": 15,
  "start": 40.32,
  "end": 42.65,
  "text": "十几个人，没有自己的产品"
 },
 {
  "i": 16,
  "start": 42.87,
  "end": 45.37,
  "text": "代理做久了，他看明白一件事"
 },
 {
  "i": 17,
  "start": 45.59,
  "end": 48.06,
  "text": "货是别人的，价格也是别人的"
 },
 {
  "i": 18,
  "start": 48.28,
  "end": 51.04,
  "text": "1990 年，华为开始自己研制"
 },
 {
  "i": 19,
  "start": 51.26,
  "end": 53.8,
  "text": "动员会上，他站在五楼的窗边"
 },
 {
  "i": 20,
  "start": 54.02,
  "end": 56.47,
  "text": "说研发成了，大家都有发展"
 },
 {
  "i": 21,
  "start": 56.69,
  "end": 59.4,
  "text": "研发败了，他只有从楼上跳下去"
 },
 {
  "i": 22,
  "start": 59.62,
  "end": 62.24,
  "text": "1993 年，C&C08 出来了"
 },
 {
  "i": 23,
  "start": 62.46,
  "end": 64.91,
  "text": "1995 年，销售额 15 亿"
 },
 {
  "i": 24,
  "start": 65.13,
  "end": 67.24,
  "text": "钱来得快，队伍也乱得快"
 },
 {
  "i": 25,
  "start": 67.46,
  "end": 71.01,
  "text": "1996 年，市场部集体辞职重新竞聘"
 },
 {
  "i": 26,
  "start": 71.23,
  "end": 73.65,
  "text": "同年开始起草《华为基本法》"
 },
 {
  "i": 27,
  "start": 73.87,
  "end": 77.21,
  "text": "1998 年，又花大钱请 I B M 顾问"
 },
 {
  "i": 28,
  "start": 77.43,
  "end": 79.78,
  "text": "学的是怎么把一个项目管好"
 },
 {
  "i": 29,
  "start": 80.0,
  "end": 82.5,
  "text": "2000 年，销售额 220 亿"
 },
 {
  "i": 30,
  "start": 82.72,
  "end": 85.29,
  "text": "也是这一年，他写了《华为的冬天》"
 },
 {
  "i": 31,
  "start": 85.51,
  "end": 87.81,
  "text": "第二年，互联网泡沫破了"
 },
 {
  "i": 32,
  "start": 88.03,
  "end": 90.91,
  "text": "2001 年 10 月，电源业务被卖掉"
 },
 {
  "i": 33,
  "start": 91.13,
  "end": 93.7,
  "text": "7.5 亿美元，买方是艾默生"
 },
 {
  "i": 34,
  "start": 93.92,
  "end": 96.2,
  "text": "这笔钱被叫作过冬的棉袄"
 },
 {
  "i": 35,
  "start": 96.42,
  "end": 99.87,
  "text": "2002 年，营收 221 亿，唯一下滑"
 },
 {
  "i": 36,
  "start": 100.09,
  "end": 102.69,
  "text": "更险的一次在 2003 年 1 月"
 },
 {
  "i": 37,
  "start": 102.91,
  "end": 105.71,
  "text": "思科在美国起诉，21 项罪名"
 },
 {
  "i": 38,
  "start": 105.93,
  "end": 107.64,
  "text": "起诉书 77 页"
 },
 {
  "i": 39,
  "start": 107.86,
  "end": 110.33,
  "text": "按对方开的价，华为要破产"
 },
 {
  "i": 40,
  "start": 110.55,
  "end": 113.24,
  "text": "合作伙伴开始观望，订单停住"
 },
 {
  "i": 41,
  "start": 113.46,
  "end": 115.71,
  "text": "华为转身去找思科的对手"
 },
 {
  "i": 42,
  "start": 115.93,
  "end": 118.45,
  "text": "2004 年 7 月，思科撤诉"
 },
 {
  "i": 43,
  "start": 118.67,
  "end": 120.69,
  "text": "命门不能攥在别人手里"
 },
 {
  "i": 44,
  "start": 120.91,
  "end": 124.1,
  "text": "2004 年，海思成立，自己做芯片"
 },
 {
  "i": 45,
  "start": 124.32,
  "end": 127.42,
  "text": "2005 年，海外收入第一次超过国内"
 },
 {
  "i": 46,
  "start": 127.64,
  "end": 130.78,
  "text": "2008 年，海外占比到 75%"
 },
 {
  "i": 47,
  "start": 131.0,
  "end": 133.95,
  "text": "2010 年，营收 1852 亿"
 },
 {
  "i": 48,
  "start": 134.17,
  "end": 137.41,
  "text": "第一次进世界 500 强，第 397 位"
 },
 {
  "i": 49,
  "start": 137.63,
  "end": 139.99,
  "text": "那时手机部门，还是个包袱"
 },
 {
  "i": 50,
  "start": 140.21,
  "end": 142.85,
  "text": "2011 年，余承东接手终端"
 },
 {
  "i": 51,
  "start": 143.07,
  "end": 145.15,
  "text": "他一上来就砍贴牌机"
 },
 {
  "i": 52,
  "start": 145.37,
  "end": 148.33,
  "text": "一年少卖三千万台，内部要换掉他"
 },
 {
  "i": 53,
  "start": 148.55,
  "end": 151.59,
  "text": "任正非说，不支持他就是不支持我"
 },
 {
  "i": 54,
  "start": 151.81,
  "end": 155.01,
  "text": "2012 年，他发微博说要做世界第一"
 },
 {
  "i": 55,
  "start": 155.23,
  "end": 157.51,
  "text": "2014 年 9 月，Mate 7"
 },
 {
  "i": 56,
  "start": 157.73,
  "end": 160.49,
  "text": "700 万台，三千元档第一次卖爆"
 },
 {
  "i": 57,
  "start": 160.71,
  "end": 163.27,
  "text": "2018 年，手机出货 2 亿台"
 },
 {
  "i": 58,
  "start": 163.49,
  "end": 166.33,
  "text": "二季度超过苹果，第一次全球第二"
 },
 {
  "i": 59,
  "start": 166.55,
  "end": 170.7,
  "text": "2019 年，2.4 亿台，营收 8588 亿"
 },
 {
  "i": 60,
  "start": 170.92,
  "end": 173.37,
  "text": "那一年 5 月，实体清单落下"
 },
 {
  "i": 61,
  "start": 173.59,
  "end": 176.42,
  "text": "芯片、系统、工具，一夜断供"
 },
 {
  "i": 62,
  "start": 176.64,
  "end": 179.13,
  "text": "海思的备胎芯片，全部转正"
 },
 {
  "i": 63,
  "start": 179.35,
  "end": 181.78,
  "text": "2019 年 8 月，鸿蒙发布"
 },
 {
  "i": 64,
  "start": 182.0,
  "end": 185.0,
  "text": "2020 年 11 月，荣耀被整体出售"
 },
 {
  "i": 65,
  "start": 185.22,
  "end": 188.05,
  "text": "卖完，华为不持股，不参与经营"
 },
 {
  "i": 66,
  "start": 188.27,
  "end": 192.04,
  "text": "2020 年营收 8914 亿，历史最高"
 },
 {
  "i": 67,
  "start": 192.26,
  "end": 195.07,
  "text": "转过一年，掉到 6368 亿"
 },
 {
  "i": 68,
  "start": 195.29,
  "end": 197.61,
  "text": "一年少了 2546 亿"
 },
 {
  "i": 69,
  "start": 197.83,
  "end": 201.12,
  "text": "手机从 2.4 亿台，掉到 3500 万"
 },
 {
  "i": 70,
  "start": 201.34,
  "end": 204.03,
  "text": "2021 年 9 月，孟晚舟回国"
 },
 {
  "i": 71,
  "start": 204.25,
  "end": 207.2,
  "text": "2023 年 8 月 29 日，没有发布会"
 },
 {
  "i": 72,
  "start": 207.42,
  "end": 210.21,
  "text": "12 点 08 分，Mate 60 Pro 上架"
 },
 {
  "i": 73,
  "start": 210.43,
  "end": 212.66,
  "text": "芯片那一栏，一个字没写"
 },
 {
  "i": 74,
  "start": 212.88,
  "end": 215.18,
  "text": "拆机的人发现，麒麟回来了"
 },
 {
  "i": 75,
  "start": 215.4,
  "end": 218.02,
  "text": "那一年，营收 7042 亿"
 },
 {
  "i": 76,
  "start": 218.24,
  "end": 220.71,
  "text": "隔了三年，它又有自己的芯片"
 },
 {
  "i": 77,
  "start": 220.93,
  "end": 223.83,
  "text": "2025 年，营收 8809 亿"
 },
 {
  "i": 78,
  "start": 224.05,
  "end": 227.37,
  "text": "离 2020 年的最高点，只差 105 亿"
 },
 {
  "i": 79,
  "start": 227.59,
  "end": 231.11,
  "text": "汽车业务这一年 450 亿，涨了 72%"
 },
 {
  "i": 80,
  "start": 231.33,
  "end": 234.33,
  "text": "鸿蒙智行一年交付 58.9 万辆"
 },
 {
  "i": 81,
  "start": 234.55,
  "end": 238.03,
  "text": "2026 年上半年，营收 4678 亿"
 },
 {
  "i": 82,
  "start": 238.25,
  "end": 240.51,
  "text": "这是它历史上最好的上半年"
 },
 {
  "i": 83,
  "start": 240.73,
  "end": 243.13,
  "text": "中国手机市场，它回到第一"
 },
 {
  "i": 84,
  "start": 243.35,
  "end": 246.95,
  "text": "份额 20.6%，出货 2760 万台"
 },
 {
  "i": 85,
  "start": 247.17,
  "end": 250.79,
  "text": "但净利掉了 37%，只剩 234 亿"
 },
 {
  "i": 86,
  "start": 251.01,
  "end": 253.22,
  "text": "钱去哪了，看研发就明白"
 },
 {
  "i": 87,
  "start": 253.44,
  "end": 257.02,
  "text": "39 年，从 2.1 万到 8809 亿"
 },
 {
  "i": 88,
  "start": 257.24,
  "end": 259.59,
  "text": "它没上市，没有市值可以讲"
 },
 {
  "i": 89,
  "start": 259.81,
  "end": 262.47,
  "text": "它把钱换成了专利、产线和人"
 },
 {
  "i": 90,
  "start": 262.69,
  "end": 264.73,
  "text": "下一段路，才刚开始"
 }
]