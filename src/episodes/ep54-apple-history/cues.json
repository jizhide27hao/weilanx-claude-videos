[
 {
  "i": 1,
  "start": 0.45,
  "end": 4.03,
  "text": "2026 年 7 月，苹果市值一度到 5 万亿美元"
 },
 {
  "i": 2,
  "start": 4.25,
  "end": 6.96,
  "text": "地球上做到这件事的，只有两家"
 },
 {
  "i": 3,
  "start": 7.18,
  "end": 9.53,
  "text": "50 年前，它在一间车库里"
 },
 {
  "i": 4,
  "start": 9.75,
  "end": 11.96,
  "text": "启动资金 1,300 美元"
 },
 {
  "i": 5,
  "start": 12.18,
  "end": 14.34,
  "text": "一辆旧车，一台计算器"
 },
 {
  "i": 6,
  "start": 14.56,
  "end": 17.41,
  "text": "中间有两次，它离关门只剩几个月"
 },
 {
  "i": 7,
  "start": 17.63,
  "end": 19.63,
  "text": "得把它这 50 年拉出来看"
 },
 {
  "i": 8,
  "start": 19.85,
  "end": 23.23,
  "text": "1976 年 4 月 1 日，加州洛斯阿尔托斯"
 },
 {
  "i": 9,
  "start": 23.45,
  "end": 26.16,
  "text": "乔布斯 21 岁，沃兹 25 岁"
 },
 {
  "i": 10,
  "start": 26.38,
  "end": 28.76,
  "text": "第三个人叫韦恩，41 岁"
 },
 {
  "i": 11,
  "start": 28.98,
  "end": 32.12,
  "text": "11 天后他退出，800 美元卖掉一成"
 },
 {
  "i": 12,
  "start": 32.34,
  "end": 35.01,
  "text": "那份合同，后来值几千亿美元"
 },
 {
  "i": 13,
  "start": 35.23,
  "end": 38.37,
  "text": "第一台机器叫 Apple 1，666.66 美元"
 },
 {
  "i": 14,
  "start": 38.59,
  "end": 41.35,
  "text": "一块电路板，机箱和键盘自己配"
 },
 {
  "i": 15,
  "start": 41.57,
  "end": 43.47,
  "text": "一共卖了大约两百台"
 },
 {
  "i": 16,
  "start": 43.69,
  "end": 46.83,
  "text": "1977 年，Apple 2 才是真正的开始"
 },
 {
  "i": 17,
  "start": 47.05,
  "end": 49.69,
  "text": "第一台普通人能搬回家用的电脑"
 },
 {
  "i": 18,
  "start": 49.91,
  "end": 52.93,
  "text": "1980 年 12 月 12 日，苹果上市"
 },
 {
  "i": 19,
  "start": 53.15,
  "end": 56.35,
  "text": "发行价 22 美元，首日收 29 美元"
 },
 {
  "i": 20,
  "start": 56.57,
  "end": 58.58,
  "text": "市值 17.8 亿美元"
 },
 {
  "i": 21,
  "start": 58.8,
  "end": 61.39,
  "text": "那天，苹果造出 4 个亿万富翁"
 },
 {
  "i": 22,
  "start": 61.61,
  "end": 65.02,
  "text": "1983 年，Lisa，9,995 美元"
 },
 {
  "i": 23,
  "start": 65.24,
  "end": 68.0,
  "text": "1984 年 1 月 22 日，超级碗"
 },
 {
  "i": 24,
  "start": 68.22,
  "end": 70.96,
  "text": "一支广告说，1 月 24 日你就明白"
 },
 {
  "i": 25,
  "start": 71.18,
  "end": 73.84,
  "text": "为什么 1984 不会是 1984"
 },
 {
  "i": 26,
  "start": 74.06,
  "end": 77.47,
  "text": "两天后，Macintosh，2,495 美元"
 },
 {
  "i": 27,
  "start": 77.69,
  "end": 80.69,
  "text": "鼠标，图形界面，一台会笑的电脑"
 },
 {
  "i": 28,
  "start": 80.91,
  "end": 84.34,
  "text": "但 128K 内存，没有硬盘，不能扩展"
 },
 {
  "i": 29,
  "start": 84.56,
  "end": 86.79,
  "text": "1985 年，销量掉下来"
 },
 {
  "i": 30,
  "start": 87.01,
  "end": 89.63,
  "text": "乔布斯和 CEO 斯卡利翻脸"
 },
 {
  "i": 31,
  "start": 89.85,
  "end": 92.49,
  "text": "5 月，董事会收走他的经营权"
 },
 {
  "i": 32,
  "start": 92.71,
  "end": 96.26,
  "text": "9 月，他辞职，卖掉全部股票，只留一股"
 },
 {
  "i": 33,
  "start": 96.48,
  "end": 99.41,
  "text": "接下来 12 年，苹果换了三个 CEO"
 },
 {
  "i": 34,
  "start": 99.63,
  "end": 101.81,
  "text": "Mac 授权给兼容机厂商"
 },
 {
  "i": 35,
  "start": 102.03,
  "end": 104.94,
  "text": "市场份额从一成多，掉到 3%"
 },
 {
  "i": 36,
  "start": 105.16,
  "end": 107.97,
  "text": "1996 财年，营收 98 亿美元"
 },
 {
  "i": 37,
  "start": 108.19,
  "end": 111.38,
  "text": "1997 财年，净亏 10.45 亿美元"
 },
 {
  "i": 38,
  "start": 111.6,
  "end": 114.84,
  "text": "按当时的现金算，离破产只剩 90 天"
 },
 {
  "i": 39,
  "start": 115.06,
  "end": 118.78,
  "text": "1996 年 12 月，4.29 亿美元买下 NeXT"
 },
 {
  "i": 40,
  "start": 119.0,
  "end": 121.21,
  "text": "乔布斯跟着这笔收购回来了"
 },
 {
  "i": 41,
  "start": 121.43,
  "end": 124.47,
  "text": "1997 年 9 月，他做临时 CEO"
 },
 {
  "i": 42,
  "start": 124.69,
  "end": 126.97,
  "text": "第一件事，给微软打电话"
 },
 {
  "i": 43,
  "start": 127.19,
  "end": 130.05,
  "text": "一个月前，微软投了 1.5 亿美元"
 },
 {
  "i": 44,
  "start": 130.27,
  "end": 133.41,
  "text": "大屏幕上，盖茨的脸出现，台下在嘘"
 },
 {
  "i": 45,
  "start": 133.63,
  "end": 135.55,
  "text": "第二件事，砍产品"
 },
 {
  "i": 46,
  "start": 135.77,
  "end": 138.34,
  "text": "15 条产品线，砍到 4 个格子"
 },
 {
  "i": 47,
  "start": 138.56,
  "end": 141.71,
  "text": "他说，决定不做什么，和做什么一样重要"
 },
 {
  "i": 48,
  "start": 141.93,
  "end": 144.21,
  "text": "1998 年 8 月，iMac"
 },
 {
  "i": 49,
  "start": 144.43,
  "end": 147.52,
  "text": "半透明的一体机，1,299 美元"
 },
 {
  "i": 50,
  "start": 147.74,
  "end": 149.64,
  "text": "第一年卖了 80 万台"
 },
 {
  "i": 51,
  "start": 149.86,
  "end": 152.14,
  "text": "2001 年 10 月，iPod"
 },
 {
  "i": 52,
  "start": 152.36,
  "end": 155.6,
  "text": "399 美元，5GB，装 1,000 首歌"
 },
 {
  "i": 53,
  "start": 155.82,
  "end": 159.39,
  "text": "2003 年，iTunes 商店，一首 99 美分"
 },
 {
  "i": 54,
  "start": 159.61,
  "end": 162.16,
  "text": "2007 年 1 月 9 日，旧金山"
 },
 {
  "i": 55,
  "start": 162.38,
  "end": 165.5,
  "text": "乔布斯说，今天苹果重新发明了手机"
 },
 {
  "i": 56,
  "start": 165.72,
  "end": 169.37,
  "text": "iPhone，6 月 29 日开卖，499 美元起"
 },
 {
  "i": 57,
  "start": 169.59,
  "end": 171.89,
  "text": "没有键盘，只有一整块玻璃"
 },
 {
  "i": 58,
  "start": 172.11,
  "end": 175.28,
  "text": "2008 年，App Store 上线，500 个应用"
 },
 {
  "i": 59,
  "start": 175.5,
  "end": 177.71,
  "text": "2010 年 1 月，iPad"
 },
 {
  "i": 60,
  "start": 177.93,
  "end": 180.64,
  "text": "那年 5 月，苹果市值超过微软"
 },
 {
  "i": 61,
  "start": 180.86,
  "end": 184.34,
  "text": "2011 年 8 月 24 日，乔布斯辞任 CEO"
 },
 {
  "i": 62,
  "start": 184.56,
  "end": 187.25,
  "text": "接任的人叫库克，管供应链出身"
 },
 {
  "i": 63,
  "start": 187.47,
  "end": 189.94,
  "text": "10 月 4 日，iPhone 4S 发布"
 },
 {
  "i": 64,
  "start": 190.16,
  "end": 192.94,
  "text": "第二天，乔布斯去世，56 岁"
 },
 {
  "i": 65,
  "start": 193.16,
  "end": 196.26,
  "text": "那一年，苹果营收 1,083 亿美元"
 },
 {
  "i": 66,
  "start": 196.48,
  "end": 199.48,
  "text": "库克接手时，市值 3,500 亿美元"
 },
 {
  "i": 67,
  "start": 199.7,
  "end": 201.98,
  "text": "他做的事，不是做新产品"
 },
 {
  "i": 68,
  "start": 202.2,
  "end": 204.45,
  "text": "是把 iPhone 铺到每一个国家"
 },
 {
  "i": 69,
  "start": 204.67,
  "end": 206.81,
  "text": "2014 年，Apple Watch"
 },
 {
  "i": 70,
  "start": 207.03,
  "end": 209.14,
  "text": "2016 年，AirPods"
 },
 {
  "i": 71,
  "start": 209.36,
  "end": 212.17,
  "text": "2018 年 8 月，市值 1 万亿美元"
 },
 {
  "i": 72,
  "start": 212.39,
  "end": 214.38,
  "text": "美国第一家做到的公司"
 },
 {
  "i": 73,
  "start": 214.6,
  "end": 216.91,
  "text": "2020 年 8 月，2 万亿"
 },
 {
  "i": 74,
  "start": 217.13,
  "end": 219.74,
  "text": "2020 年 11 月，M1 芯片"
 },
 {
  "i": 75,
  "start": 219.96,
  "end": 222.24,
  "text": "Mac 和英特尔，从此分手"
 },
 {
  "i": 76,
  "start": 222.46,
  "end": 224.74,
  "text": "2022 年 1 月，3 万亿"
 },
 {
  "i": 77,
  "start": 224.96,
  "end": 228.54,
  "text": "2025 财年，服务收入 1,093 亿美元"
 },
 {
  "i": 78,
  "start": 228.76,
  "end": 232.26,
  "text": "毛利率 75%，硬件只有 36%"
 },
 {
  "i": 79,
  "start": 232.48,
  "end": 234.55,
  "text": "这才是库克真正的作品"
 },
 {
  "i": 80,
  "start": 234.77,
  "end": 237.24,
  "text": "但 2022 年底，大模型来了"
 },
 {
  "i": 81,
  "start": 237.46,
  "end": 239.91,
  "text": "苹果成了所有巨头里最慢的那个"
 },
 {
  "i": 82,
  "start": 240.13,
  "end": 242.31,
  "text": "Siri 的升级，一推再推"
 },
 {
  "i": 83,
  "start": 242.53,
  "end": 246.15,
  "text": "2024 年，Vision Pro，3,499 美元"
 },
 {
  "i": 84,
  "start": 246.37,
  "end": 249.64,
  "text": "一台戴在脸上的电脑，没成为下一个 iPhone"
 },
 {
  "i": 85,
  "start": 249.86,
  "end": 252.19,
  "text": "2025 年 10 月，4 万亿"
 },
 {
  "i": 86,
  "start": 252.41,
  "end": 254.66,
  "text": "2026 年 7 月，5 万亿"
 },
 {
  "i": 87,
  "start": 254.88,
  "end": 257.62,
  "text": "2026 年 9 月 1 日，库克卸任"
 },
 {
  "i": 88,
  "start": 257.84,
  "end": 260.41,
  "text": "接任的是特努斯，硬件工程师"
 },
 {
  "i": 89,
  "start": 260.63,
  "end": 263.48,
  "text": "9 月，苹果发布第一台折叠手机"
 },
 {
  "i": 90,
  "start": 263.7,
  "end": 266.7,
  "text": "50 年，从 1,300 美元到 5 万亿"
 },
 {
  "i": 91,
  "start": 266.92,
  "end": 269.95,
  "text": "它没发明手机，也没发明音乐播放器"
 },
 {
  "i": 92,
  "start": 270.17,
  "end": 273.36,
  "text": "它做的，是把已有的东西做到让人排队"
 },
 {
  "i": 93,
  "start": 273.58,
  "end": 275.76,
  "text": "但这一次，AI 不等它"
 },
 {
  "i": 94,
  "start": 275.98,
  "end": 279.25,
  "text": "50 年里，苹果最擅长的从来不是先做"
 },
 {
  "i": 95,
  "start": 279.47,
  "end": 282.42,
  "text": "是等别人做完，再做得让人离不开"
 },
 {
  "i": 96,
  "start": 282.64,
  "end": 284.44,
  "text": "这一次，还管用吗"
 }
]